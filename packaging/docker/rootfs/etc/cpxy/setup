#!/bin/sh
# Runs once before the services start: checks the container's settings and writes what the
# services need under /run/cpxy. Any bad setting stops the container, with a message naming it.
#
# Inside the container tsgw reaches the client's HTTP proxy over loopback, for Tailscale's control
# and DERP traffic. Its alternative DNS goes through the cpxy server by itself (DNS_ALTERNATIVE).
set -eu

# CPXY_RUN is for the tests
RUN="${CPXY_RUN:-/run/cpxy}"

fail() {
	echo "cpxy: $*" >&2
	exit 1
}

# uint <value> <min> <max>
uint() {
	case "$1" in '' | *[!0-9]*) return 1 ;; esac
	[ "${#1}" -le 7 ] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

# split <var> <host:port>: sets <var>_HOST and <var>_PORT; an IPv6 host keeps its brackets
split() {
	local host="${2%:*}" port="${2##*:}"
	case "$2" in *:*) ;; *) host= ;; esac
	case "$host" in
	\[*\]) ;;
	*:* | '') fail "$1 must be host:port, e.g. [::]:5000 or 127.0.0.1:5000, not '$2'" ;;
	esac
	uint "$port" 1 65535 || fail "$1 has no valid port: '$2'"
	eval "${1}_HOST=\$host ${1}_PORT=\$port"
}

# Where the other services reach a listener: a wildcard address means loopback
connect_addr() {
	case "$1" in
	0.0.0.0 | \[::\]) echo "127.0.0.1:$2" ;;
	*) echo "$1:$2" ;;
	esac
}

[ -n "${SERVER:-}" ] || fail "SERVER is required: the cpxy server URL with its key, e.g. https://:<key>@<host>"

split HTTP_PROXY_LISTEN "${HTTP_PROXY_LISTEN:-}"
[ -z "${SOCKS5_PROXY_LISTEN:-}" ] || split SOCKS5_PROXY_LISTEN "$SOCKS5_PROXY_LISTEN"
proxy="http://$(connect_addr "$HTTP_PROXY_LISTEN_HOST" "$HTTP_PROXY_LISTEN_PORT")"

umask 077
rm -rf "$RUN"
mkdir -p "$RUN/env/client" "$RUN/env/tsgw"

# Read by s6-envdir in each service's run script, over the container's environment. An empty
# file unsets the variable: the client refuses an empty SOCKS5_PROXY_LISTEN rather than skip it.
printf '%s\n' "$SERVER" >"$RUN/env/client/CONFIG"
if [ -n "${SOCKS5_PROXY_LISTEN:-}" ]; then
	printf '%s\n' "$SOCKS5_PROXY_LISTEN" >"$RUN/env/client/SOCKS5_PROXY_LISTEN"
else
	: >"$RUN/env/client/SOCKS5_PROXY_LISTEN"
fi
printf '%s\n' "$proxy" >"$RUN/env/tsgw/HTTPS_PROXY"
printf '%s\n' "$proxy" >"$RUN/env/tsgw/HTTP_PROXY"

echo "cpxy: proxy on $HTTP_PROXY_LISTEN, tailnet name ${TS_HOSTNAME:-cpxy-tsgw}"
