#!/bin/sh
set -e
[ "$1" = configure ] || exit 0

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload
	# An upgrade picks up the new binary; a service that was not running stays stopped
	if [ -n "${2:-}" ]; then
		systemctl try-restart cpxy-tsgw.service || true
	fi
fi

if [ -z "${2:-}" ]; then
	cat <<'MSG'
cpxy-tsgw installed. Set SERVER (and check the DNS servers) in /etc/cpxy/cpxy-tsgw.conf, then:
  systemctl enable --now cpxy-tsgw
  journalctl -u cpxy-tsgw -f      # shows the Tailscale login link
Guide: https://github.com/simophin/cpxy-ng/blob/main/docs/cpxy-tsgw.md
MSG
fi
exit 0
