#!/bin/sh
[ -s "${IPKG_INSTROOT}/lib/functions.sh" ] || exit 0
. "${IPKG_INSTROOT}/lib/functions.sh"
# An upgrade from a package with cpxy-smartdns stopped it and removed its script, but leaves its
# boot links and generated files
rm -f "${IPKG_INSTROOT}"/etc/rc.d/[SK][0-9][0-9]cpxy-smartdns
[ -n "${IPKG_INSTROOT}" ] || rm -f /tmp/cpxy/smartdns-*.conf
# cpxy-router answers DNS itself now; the separate cpxy-dns-split's settings held the server key
[ -n "${IPKG_INSTROOT}" ] || rm -f /tmp/cpxy/dns-*.env
rmdir "${IPKG_INSTROOT}/usr/share/doc/cpxy" 2>/dev/null
# Likewise for cpxy-tsgw (the Tailscale exit node, since removed). Its generated files held the
# server key. Each exit node's Tailscale identity in /etc/cpxy/tsgw is left for the user to delete.
rm -f "${IPKG_INSTROOT}"/etc/rc.d/[SK][0-9][0-9]cpxy-tsgw
[ -n "${IPKG_INSTROOT}" ] || rm -f /tmp/cpxy/tsgw-*.env
# Enables and starts the cpxy-* services; they wait until a server is configured
default_postinst "$0" "$@"
if [ -z "${IPKG_INSTROOT}" ] && [ "$PKG_UPGRADE" != 1 ]; then
	cat <<MSG
cpxy installed. Set the server (/etc/config/cpxy lists every option) and the services start:
  uci set cpxy.defaults.server='http://:<key>@<host>:<port>'
  uci commit cpxy
MSG
fi
exit 0
