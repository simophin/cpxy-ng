#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
USE_PROCD=1
START=19
STOP=10
EXTRA_COMMANDS="cleanup"
EXTRA_HELP="        cleanup Remove RTP policy and restore ordinary LAN routing"

start_service() {
	/usr/libexec/cpxy-rtp/policy.sh prepare || return 1
	[ -f /var/run/cpxy-rtp/enabled ] || return 0
	procd_open_instance main
	procd_set_param command /usr/libexec/cpxy-rtp/policy.sh run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}
reload_service() {
	/usr/libexec/cpxy-rtp/policy.sh prepare || return 1
	stop
	start
}
service_triggers() { procd_add_reload_trigger cpxy_rtp; }
# Guards deliberately survive stop, crashes and disabled configuration.
cleanup() {
	stop
	/usr/libexec/cpxy-rtp/policy.sh cleanup
}
