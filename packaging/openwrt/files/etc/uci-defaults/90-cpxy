#!/bin/sh
# Remove the former fixed zone/include. Active instances configure their own firewall.
. /lib/functions.sh
. /usr/libexec/cpxy/firewall.sh
cpxy_firewall_clear
uci commit firewall
if command -v iptables >/dev/null; then
	while iptables -D FORWARD -o cpxy0 -p udp -j REJECT 2>/dev/null; do :; done
fi
/etc/init.d/firewall reload >/dev/null 2>&1
exit 0
