# cpxy: one instance per set of networks. Each instance runs, for its own cpxy server:
#   cpxy-client    an HTTP proxy, which tsgw also uses
#   cpxy-router    the networks' TCP through the server, and their DNS through dns_split
#   cpxy-tsgw      a Tailscale exit node with the same routing and DNS
# Every option in 'defaults' can also be set in an instance, which then wins.
# After editing: uci commit cpxy, then each service reloads by itself.

config defaults 'defaults'
	# REQUIRED, here or in each instance: https://:<key>@<host>:<port> (or http://)
	option server ''
	# Force matching IPv4 TCP destinations through the proxy (repeatable).
	# list proxy_route '223.5.5.5/32'

	# The components every instance runs (1) or not (0)
	option client '1'
	option router '1'
	option tsgw '1'

	# cpxy-client: an HTTP proxy on [::]:5000+index. 1 adds a SOCKS5 proxy on [::]:1080+index.
	option client_socks5 '0'

	# Split DNS, for the networks (dns_split, in cpxy-router) and for cpxy-tsgw's clients.
	# The dns_upstream answer is used when all its addresses are in the local region, the
	# dns_alternative answer otherwise. Each entry is an IP, or a udp://, tcp://, tls:// or
	# https:// URL (tls:// and https:// accept ?ip=<addr>). tcp://, tls:// and https:// accept
	# ?via=cpxy to ask through the instance's cpxy server, so the answer is neither poisoned nor
	# blocked.
	list dns_upstream '223.5.5.5'
	list dns_upstream '119.29.29.29'
	# Unset: tcp://1.1.1.1?via=cpxy and tcp://8.8.8.8?via=cpxy
	# list dns_alternative 'https://dns.google/dns-query?ip=8.8.8.8&via=cpxy'
	option dns_cache '1'
	# Answer names on the built-in ad blocklist with an address that goes nowhere
	option block_ads '1'
	# Names the router itself answers, sent to dns_local_server: single-label names, reverse
	# lookups of private addresses and these domains. Unset: dnsmasq's 'domain' and 'local'.
	# list dns_local_domain 'lan'
	option dns_local_server '127.0.0.1:53'

	# cpxy-router: 1 answers all IPv4 DNS from the instance's networks with its dns_split
	option router_dns '1'

	# cpxy-tsgw: log in with the link in `logread -e cpxy-tsgw`, or once with an auth key
	option tsgw_authkey ''
	# A different coordination server, e.g. Headscale. One whose certificate is not from
	# Let's Encrypt also needs: opkg install ca-bundle
	option tsgw_control_url ''
	option tsgw_mtu '1280'
	# 1 reaches Tailscale's coordination and relay (DERP) servers through the instance's proxy
	option tsgw_proxy '1'
	option tsgw_no_logs_no_support '0'
	option tsgw_verbose '0'

config instance 'main'
	option enabled '1'
	# 0..9, unique. Everything below defaults to a value derived from it; set one only if it
	# clashes with something else on the router.
	option index '0'
	# The OpenWrt networks whose devices use this instance (none: client and tsgw only)
	list network 'lan'
	# Derived from index (i):
	#   tun 'cpxy<i>'                          routing_table '100+i'
	#   rule_priority '9100+10i' (uses 4)      client_http_listen '[::]:5000+i'
	#   client_socks5_listen '[::]:1080+i'     dns_listen '0.0.0.0:5335+10i'
	#   tsgw_port '41700+i'                    tsgw_hostname 'cpxy-<name>'
	#   tsgw_state_dir '/etc/cpxy/tsgw/<name>'

