# cpxy: one instance per set of networks. Each instance runs, for its own cpxy server:
#   cpxy-client    an HTTP proxy, and for routed networks the transparent proxy their overseas
#                  TCP is redirected to
#   cpxy-router    the kernel policy (nftables: CN/private TCP direct, the rest redirected to
#                  cpxy-client) and split DNS
# Every option in 'defaults' can also be set in an instance, which then wins.
# After editing: uci commit cpxy, then each service reloads by itself.

config defaults 'defaults'
	# Required: http://:<key>@<host>:<port>
	option server ''
	# Force matching TCP destinations through the proxy (repeatable, IPv4 or IPv6).
	# list proxy_route '223.5.5.5/32'

	# The components every instance runs (1) or not (0)
	option client '1'
	option router '1'

	# cpxy-client: an HTTP proxy on [::]:5000+index. 1 adds a SOCKS5 proxy on [::]:1080+index,
	# which an instance with networks always has: its DNS worker asks proxied resolvers through it.
	option client_socks5 '0'

	# Optional ordered suffixes for short DNS names, for router clients.
	# list dns_search_domain 'home.arpa'
	# list dns_search_domain 'corp.example'

	# Split DNS, for the networks (dns_split, in cpxy-router).
	# A dns_upstream answer with regional addresses wins (nonregional addresses removed),
	# otherwise prefer dns_alternative. Each entry is an IP, or a udp://, tcp://, tls:// or
	# https:// URL (tls:// and https:// accept ?ip=<addr>). tcp://, tls:// and https:// accept
	# ?via=cpxy as an explicit proxy override (through the router's SOCKS5 endpoint).
	# Router specs otherwise follow destination routing; proxied UDP specs use TCP.
	list dns_upstream '223.5.5.5'
	# Unset: tcp://1.1.1.1?via=cpxy
	# list dns_alternative 'https://dns.google/dns-query?ip=8.8.8.8&via=cpxy'
	option dns_cache '1'
	# Names the router itself answers, sent to dns_local_server: single-label names, reverse
	# lookups of private addresses and these domains. Unset: dnsmasq's 'domain' and 'local'.
	# list dns_local_domain 'lan'
	option dns_local_server '127.0.0.1:53'

	# cpxy-router: 1 answers IPv4/IPv6 DNS from the instance's networks with its dns_split
	option router_dns '1'
	# Kernel IPv4 regional TCP forwarding (required).
	# Disable firewall software/hardware flow offloading, which bypasses the redirect.
	# IPv6 forwarding from the networks is refused.
	option router_geoip '1'

config instance 'main'
	option enabled '1'
	# 0..9, unique. Everything below defaults to a value derived from it; set one only if it
	# clashes with something else on the router.
	option index '0'
	# The OpenWrt networks whose devices use this instance (none: client only)
	list network 'lan'
	# Derived from index (i):
	#   client_http_listen '[::]:5000+i'       client_socks5_listen '[::]:1080+i'
	#   client_transparent_listen '0.0.0.0:5100+i'  dns_listen '[::]:5335+10i'

