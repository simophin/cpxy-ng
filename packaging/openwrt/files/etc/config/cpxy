config cpxy 'main'
	# The service starts only once every required option below is filled in and enabled is 1:
	#   /etc/init.d/cpxy enable; uci set cpxy.main.enabled=1; uci commit cpxy; /etc/init.d/cpxy restart
	option enabled '0'

	# REQUIRED. The cpxy server, as https://:<key>@<host>:<port> (or http://). Contains the secret key.
	option server ''

	# UCI network interfaces whose devices are proxied (more than one allowed)
	list lan_interface 'lan'

	# LAN DNS: dnsmasq forwards public queries to dns_split. Set dns_split to 0 to leave dnsmasq alone.
	option dns_split '1'
	# Not 5353: that is the mDNS port, already taken where avahi or umdns runs
	option dns_listen '127.0.0.1:5335'

	# REQUIRED when dns_split is 1. An answer from the upstream servers wins when all its addresses
	# are in the CN region; otherwise the alternative servers' answer is used.
	# Each entry is an IP, or a udp://, tcp://, tls:// or https:// URL (tls:// and https:// accept ?ip=<addr>).
	# Add with: uci add_list cpxy.main.dns_upstream='<server>'
	#           uci add_list cpxy.main.dns_alternative='<server>'

	# 1 keeps dns_split's SQLite answer cache in /tmp (RAM), 0 disables it
	option dns_cache '1'

	# Legacy socks5_listen, api_listen and dns_server options are ignored.
