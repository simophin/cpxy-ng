# cpxy: one instance per set of networks. Each instance runs, for its own cpxy server:
#   cpxy-client    an HTTP proxy, which tsgw also uses
#   cpxy-router    kernel CN TCP, overseas TCP through SOCKS5, and split DNS
#   cpxy-tsgw      a Tailscale exit node with the same routing and DNS
# Every option in 'defaults' can also be set in an instance, which then wins.
# After editing: uci commit cpxy, then each service reloads by itself.

config defaults 'defaults'
	# Required for client/tsgw (external-only routers need no server): https://:<key>@<host>:<port> (or http://)
	option server ''
	# Force matching TCP destinations through the proxy (repeatable, IPv4 or IPv6).
	# list proxy_route '223.5.5.5/32'

	# IPv6 from the networks and Tailscale clients: 'full' routes it like IPv4, which needs a
	# server that reaches IPv6; 'direct' only what goes direct (local-region and private
	# addresses), for a server that does not; 'off' refuses it, so clients use IPv4.
	option ipv6 'full'

	# The components every instance runs (1) or not (0)
	option client '1'
	option router '1'
	option tsgw '1'

	# cpxy-client: an HTTP proxy on [::]:5000+index. 1 adds a SOCKS5 proxy on [::]:1080+index.
	option client_socks5 '0'
	# Router automatically enables the sibling SOCKS5 listener unless an external
	# plaintext no-auth endpoint is supplied. External-only: set client=0 and tsgw=0.
	# option router_socks5_proxy '127.0.0.1:1080'

	# Optional ordered suffixes for short DNS names, for router and Tailscale clients.
	# list dns_search_domain 'home.arpa'
	# list dns_search_domain 'corp.example'

	# Split DNS, for the networks (dns_split, in cpxy-router) and for cpxy-tsgw's clients.
	# A dns_upstream answer with regional addresses wins (nonregional addresses removed),
	# otherwise prefer dns_alternative. Each entry is an IP, or a udp://, tcp://, tls:// or
	# https:// URL (tls:// and https:// accept ?ip=<addr>). tcp://, tls:// and https:// accept
	# ?via=cpxy to ask through the instance's cpxy server, so the answer is neither poisoned nor
	# blocked.
	list dns_upstream '223.5.5.5'
	# Unset: tcp://1.1.1.1?via=cpxy
	# list dns_alternative 'https://dns.google/dns-query?ip=8.8.8.8&via=cpxy'
	option dns_cache '1'
	# Names the router itself answers, sent to dns_local_server: single-label names, reverse
	# lookups of private addresses and these domains. Unset: dnsmasq's 'domain' and 'local'.
	# list dns_local_domain 'lan'
	option dns_local_server '127.0.0.1:53'

	# cpxy-router: 1 answers IPv4/IPv6 DNS from the instance's networks with its dns_split
	option router_dns '1'
	# Kernel IPv4/IPv6 regional TCP forwarding (required).
	# Disable firewall software/hardware flow offloading before enabling.
	# IPv6 uses the same policy as IPv4. The shared ipv6 option still serves tsgw.
	option router_geoip '1'
	option router_ipv6 'full'

	# Optional offline traffic page and read-only API. No authentication; defaults to loopback.
	# Reach it with an SSH tunnel, or set router_api_listen in an instance to a management IP.
	option router_api '0'

	# cpxy-tsgw: log in with the link in `logread -e cpxy-tsgw`, or once with an auth key
	option tsgw_authkey ''
	# A different coordination server, e.g. Headscale, with a certificate from a public CA
	option tsgw_control_url ''
	option tsgw_mtu '1280'
	# 1 reaches Tailscale's coordination and relay (DERP) servers through the instance's proxy
	option tsgw_proxy '1'
	option tsgw_verbose '0'

config instance 'main'
	option enabled '1'
	# 0..9, unique. Everything below defaults to a value derived from it; set one only if it
	# clashes with something else on the router.
	option index '0'
	# The OpenWrt networks whose devices use this instance (none: client and tsgw only)
	list network 'lan'
	# Derived from index (i):
	#   tun 'cpxy<i>'                          routing_table '100+i'
	#   rule_priority '9100+10i' (uses 5)      client_http_listen '[::]:5000+i'
	#   client_socks5_listen '[::]:1080+i'     dns_listen '[::]:5335+10i'
	#   router_api_listen '127.0.0.1:3010+i'
	#   tsgw_port '41700+i'                    tsgw_hostname 'cpxy-<name>'
	#   tsgw_state_dir '/etc/cpxy/tsgw/<name>'

