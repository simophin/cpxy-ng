#!/bin/sh /etc/rc.common
# Restore only the last applied GeoIP protection before firewall (19) and network (20).
# No DNS, network discovery or running worker is required at this point in boot.
# shellcheck disable=SC2034
START=18
# shellcheck disable=SC2034
STOP=11

. /usr/libexec/cpxy/instance.sh
. /usr/libexec/cpxy/net.sh
. /usr/libexec/cpxy/geo.sh

start() {
	/etc/init.d/cpxy-router enabled || return 0
	local state tun table priority devices name kind enabled loaded=1
	config_load cpxy || loaded=0
	for state in /etc/cpxy/router-guards/*; do
		[ -f "$state" ] || continue
		name="${state##*/}"
		if [ "$loaded" = 1 ]; then
			config_get kind "$name" TYPE
			config_get_bool enabled "$name" enabled 1
			cpxy_instance "$name"
			[ "$kind" = instance ] && [ "$enabled$CPXY_ROUTER$CPXY_GEOIP" = 111 ] && [ -n "$CPXY_NETWORKS" ] || continue
		fi
		{
			read -r tun
			read -r table
			read -r priority
			read -r devices
		} <"$state"
		_cpxy_uint "$table" 1 55535 && _cpxy_uint "$priority" 1 32761 || return 1
		cpxy_net_select "$tun" "$table" "$priority"
		cpxy_geo_guard "$tun" $devices || return 1
		mkdir -p "$CPXY_RUN/instances" || return 1
		[ -f "$CPXY_RUN/instances/$name" ] || cp "$state" "$CPXY_RUN/instances/$name" || return 1
	done
	return 0
}

# Only cpxy-router's explicit stop removes protection. Shutdown retains it until reboot.
stop() { :; }
