#!/bin/sh /etc/rc.common
# One smartdns per cpxy instance, on its own port, asking overseas servers through the instance's
# HTTP proxy. It is only dns_split's alternative server: it never serves the system or the LAN,
# reads no system resolver settings and leaves the smartdns package (if any) alone.
# rc.common consumes these service metadata variables.
# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=91
# shellcheck disable=SC2034
STOP=10

. /usr/libexec/cpxy/instance.sh

_yesno() { [ "$1" = 1 ] && echo yes || echo no; }

_write_conf() {
	local conf="$1" entry proxy=""
	[ "$CPXY_SMARTDNS_PROXY" = 1 ] && proxy=" -proxy cpxy"
	{
		echo "# Generated by /etc/init.d/cpxy-smartdns from /etc/config/cpxy; do not edit."
		echo "bind $CPXY_SMARTDNS_LISTEN"
		echo "bind-tcp $CPXY_SMARTDNS_LISTEN"
		[ "$CPXY_SMARTDNS_PROXY" = 1 ] && echo "proxy-server $CPXY_PROXY -name cpxy"
		for entry in $CPXY_SMARTDNS_SERVERS; do
			echo "server $entry$proxy"
		done
		echo "cache-size $CPXY_SMARTDNS_CACHE_SIZE"
		echo "cache-persist no"
		echo "prefetch-domain $(_yesno "$CPXY_SMARTDNS_PREFETCH")"
		echo "serve-expired $(_yesno "$CPXY_SMARTDNS_SERVE_EXPIRED")"
		# Testing which answer is fastest would probe the answers from the router, directly
		echo "speed-check-mode none"
		echo "log-console yes"
		echo "log-level warn"
	} >"$conf"
}

_start_instance() {
	local conf="$CPXY_RUN/smartdns-$1.conf"
	[ "$CPXY_SMARTDNS" = 1 ] || return 0
	_write_conf "$conf"
	procd_open_instance "$1"
	procd_set_param command "$CPXY_BIN/cpxy-smartdns" -f -c "$conf" -p -
	# A changed configuration restarts the instance
	procd_set_param file "$conf"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	cpxy_validate || return 1
	mkdir -p "$CPXY_RUN"
	cpxy_foreach _start_instance
}

service_triggers() {
	procd_add_reload_trigger cpxy
}
