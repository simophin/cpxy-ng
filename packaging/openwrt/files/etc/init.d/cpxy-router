#!/bin/sh /etc/rc.common
# Per cpxy instance: a native packet worker for its networks' TCP, which also answers their DNS
# with dns_split. The system's own resolver (dnsmasq) is left alone.
# rc.common consumes these service metadata variables.
# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10

. /lib/functions/network.sh
. /usr/libexec/cpxy/instance.sh
. /usr/libexec/cpxy/net.sh
. /usr/libexec/cpxy/geo.sh
. /usr/libexec/cpxy/firewall.sh

CPXY_STATE="$CPXY_RUN/instances"
CPXY_BOOT_STATE=/etc/cpxy/router-guards

_invalid() { cpxy_log "$*"; VALID=0; }

_validate_network() {
	local iface="$1" zone dev network
	case "$iface" in '' | *[!A-Za-z0-9_]*) _invalid "$SECTION: invalid network name"; return ;; esac
	case " $NETWORKS " in *" $iface "*) _invalid "$SECTION: network '$iface' is assigned more than once" ;; esac
	NETWORKS="$NETWORKS $iface"
	zone="$(cpxy_firewall_zone "$iface")" || { _invalid "$SECTION: network '$iface' must belong to exactly one enabled firewall zone"; return; }
	case "$zone" in '' | *[!A-Za-z0-9_]*) _invalid "$SECTION: unsupported firewall zone name"; return ;; esac
	case " $ZONES " in *" $zone "*) ;; *) ZONES="$ZONES $zone" ;; esac
	# DNS is redirected per zone, so a zone must not also hold another instance's networks
	if [ "$CPXY_ROUTER_DNS" = 1 ]; then
		for network in $(cpxy_firewall_zone_networks "$zone"); do
			case " $CPXY_NETWORKS " in
			*" $network "*) ;;
			*) _invalid "$SECTION: firewall zone '$zone' also holds network '$network'; with router_dns, add it to this instance or move it to another zone" ;;
			esac
		done
	fi
	if network_get_device dev "$iface" && [ -n "$dev" ]; then
		case " $DEVICES " in *" $dev "*) _invalid "$SECTION: device '$dev' is assigned more than once" ;; esac
		DEVICES="$DEVICES $dev"
		LAN_DEVS="$LAN_DEVS $dev"
	else
		cpxy_log "$SECTION: interface '$iface' has no device yet; awaiting network event"
	fi
}

_validate_instance() {
	local tun="$CPXY_TUN" table="$CPXY_TABLE" priority="$CPXY_PRIORITY" old iface dns_port=- entry geo_hash=- uplink='- -' mode="$CPXY_IPV6"
	SECTION="$1"
	[ "$CPXY_ROUTER" = 1 ] || return 0
	[ -n "$CPXY_NETWORKS" ] || return 0
	case "$tun" in '' | *[!A-Za-z0-9_-]* | lo) _invalid "$SECTION: invalid tun"; return ;; esac
	[ "${#tun}" -le 15 ] || { _invalid "$SECTION: tun exceeds 15 characters"; return; }
	if ip link show "$tun" >/dev/null 2>&1 && ! ip tuntap show dev "$tun" | grep -q "^$tun: tun"; then
		_invalid "$SECTION: existing device '$tun' is not a TUN"
		return
	fi
	_cpxy_uint "$table" 1 65535 && [ "$table" -ne 253 ] && [ "$table" -ne 254 ] && [ "$table" -ne 255 ] || {
		_invalid "$SECTION: routing_table must be 1..65535, excluding 253..255"
		return
	}
	_cpxy_uint "$priority" 1 32762 || { _invalid "$SECTION: rule_priority must be 1..32762"; return; }
	if [ "$CPXY_GEOIP" != 1 ] && [ -f "$CPXY_STATE/$SECTION" ] && [ "$(sed -n '8p' "$CPXY_STATE/$SECTION")" = 1 ]; then
		_invalid "$SECTION: stop cpxy-router before disabling router_geoip"
		return
	fi
	if [ "$CPXY_GEOIP" = 1 ]; then
		[ "$priority" -le 32761 ] || { _invalid "$SECTION: GeoIP rule_priority must be 1..32761"; return; }
		[ "$CPXY_ROUTER_IPV6" = off ] || { _invalid "$SECTION: router_geoip requires router_ipv6 off"; return; }
		mode=off
		[ "$table" -le 55535 ] || { _invalid "$SECTION: GeoIP routing_table must leave room for staging table +10000"; return; }
		for entry in flow_offloading flow_offloading_hw; do
			[ "$(uci -q get "firewall.@defaults[0].$entry")" != 1 ] || {
				_invalid "$SECTION: disable $entry before enabling router_geoip"
				return
			}
		done
		uplink="$(cpxy_geo_uplink)" || { _invalid "$SECTION: router_geoip requires one simple main-table IPv4 default"; return; }
		set -- --export-direct-routes
		for entry in $CPXY_PROXY_ROUTES; do
			case "$entry" in *:*) _invalid "$SECTION: router_geoip accepts IPv4 proxy_route only"; return ;; esac
			set -- "$@" --proxy-route "$entry"
		done
		"$CPXY_BIN/cpxy-router" "$@" >"$PLAN/routes/$SECTION" || { _invalid "$SECTION: route export failed"; return; }
		geo_hash="$(sha256sum <"$PLAN/routes/$SECTION")" || { _invalid "$SECTION: policy checksum failed"; return; }
		# Resource changes must not remove the running instance's guard before replacement.
		if [ -f "$CPXY_STATE/$SECTION" ]; then
			[ "$(sed -n '8p' "$CPXY_STATE/$SECTION")" = 1 ] || {
				_invalid "$SECTION: stop cpxy-router before enabling router_geoip"
				return
			}
			old="$(head -n 3 "$CPXY_STATE/$SECTION")"
			[ "$old" = "$(printf '%s\n%s\n%s' "$tun" "$table" "$priority")" ] || {
				_invalid "$SECTION: stop cpxy-router before changing GeoIP tun/table/priorities"
				return
			}
		fi
		# Never flush a table/priority range claimed by a different service.
		if [ ! -f "$CPXY_STATE/$SECTION" ]; then
			for entry in "$table" "$((table + 10000))"; do
				[ -z "$(ip -4 route show table "$entry" 2>/dev/null)" ] || _invalid "$SECTION: routing table $entry is already occupied"
			done
			for entry in "$priority" "$((priority + 1))" "$((priority + 2))" "$((priority + 3))" "$((priority + 4))"; do
				[ -z "$(ip -4 rule show priority "$entry")$(ip -6 rule show priority "$entry")" ] || _invalid "$SECTION: rule priority $entry is already occupied"
			done
		fi
	fi
	case " $TUNS " in *" $tun "*) _invalid "$SECTION: duplicate tun '$tun'" ;; esac
	case " $TABLES " in *" $table "*) _invalid "$SECTION: duplicate routing_table '$table'" ;; esac
	if [ "$CPXY_GEOIP" = 1 ]; then
		case " $TABLES " in *" $((table + 10000)) "*) _invalid "$SECTION: duplicate staging table" ;; esac
		TABLES="$TABLES $((table + 10000))"
	fi
	for old in $PRIORITIES; do
		[ "$priority" -gt "$((old + 4))" ] || [ "$((priority + 4))" -lt "$old" ] || _invalid "$SECTION: overlapping rule priorities"
	done
	TUNS="$TUNS $tun"
	TABLES="$TABLES $table"
	PRIORITIES="$PRIORITIES $priority"
	LAN_DEVS=""
	ZONES=""
	for iface in $CPXY_NETWORKS; do
		_validate_network "$iface"
	done
	[ "$CPXY_ROUTER_DNS" = 1 ] && dns_port="$(_cpxy_port "$CPXY_DNS_LISTEN")"
	printf '%s\n' "$tun" "$table" "$priority" "$LAN_DEVS" "$ZONES" "$dns_port" "$mode" "$CPXY_GEOIP" "$uplink" "$geo_hash" >"$PLAN/$SECTION"
}

_prepare_plan() {
	cpxy_validate || return 1
	PLAN="$(mktemp -d /tmp/cpxy-plan.XXXXXX)" || return 1
	mkdir "$PLAN/routes" || return 1
	VALID=1 NETWORKS="" DEVICES="" TUNS="" TABLES="" PRIORITIES=""
	cpxy_foreach _validate_instance
	# Never assign a protected bridge as a TUN, even across different instances.
	local tun
	for tun in $TUNS; do
		case " $DEVICES " in *" $tun "*) _invalid "tun '$tun' is also a protected network device" ;; esac
	done
	if [ "$VALID" != 1 ]; then
		rm -rf "$PLAN"
		return 1
	fi
}

_read_state() {
	{
		read -r TUN
		read -r TABLE
		read -r PRIORITY
		read -r LAN_DEVS
		read -r ZONES
		read -r DNS_PORT
		# For cpxy_net_up
		read -r CPXY_IPV6
		read -r GEOIP || GEOIP=0
		read -r UPLINK || UPLINK='- -'
	} <"$1"
	cpxy_net_select "$TUN" "$TABLE" "$PRIORITY"
}

_start_worker() {
	local entry
	procd_open_instance "${1}_tun"
	procd_set_param command "$CPXY_BIN/cpxy-router" --tun "$TUN" --ipv6 "$CPXY_IPV6"
	# Kernel owns the direct decision. Every TCP packet still reaching TUN must use cpxy,
	# including during policy reloads; never let an old worker reclassify it as direct.
	[ "$GEOIP" != 1 ] || procd_append_param command --proxy-route 0.0.0.0/0
	[ "$CPXY_ROUTER_API" = 0 ] || procd_append_param command --api-listen "$CPXY_ROUTER_API_LISTEN"
	if [ "$GEOIP" != 1 ]; then
		for entry in $CPXY_PROXY_ROUTES; do procd_append_param command --proxy-route "$entry"; done
	fi
	if [ "$DNS_PORT" != - ]; then
		procd_append_param command --dns-listen "$CPXY_DNS_LISTEN"
		for entry in $CPXY_DNS_SEARCH_DOMAINS; do procd_append_param command --dns-search-domain "$entry"; done
		for entry in $CPXY_DNS_UPSTREAM; do procd_append_param command --dns-upstream "$entry"; done
		for entry in $CPXY_DNS_ALTERNATIVE; do procd_append_param command --dns-alternative "$entry"; done
		procd_append_param command --dns-local-server "$CPXY_DNS_LOCAL_SERVER"
		for entry in $CPXY_DNS_LOCAL_DOMAINS; do procd_append_param command --dns-local-domain "$entry"; done
		[ "$CPXY_DNS_CACHE" = 1 ] || procd_append_param command --no-dns-cache
	fi
	# The server URL holds the key: in the environment, out of the process list. dns_split asks
	# the servers given with ?via=cpxy through it.
	cpxy_procd_env "router-$1" SERVER="$CPXY_SERVER" NO_COLOR=1
	# A package/data update must also replace DNS workers using the old embedded dataset.
	procd_append_param file "$CPXY_BIN/cpxy-router"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

_start_instance() {
	local state="$PLAN/$1" wan
	[ -f "$state" ] || return 0
	ROUTED=1
	_read_state "$state"
	wan="${UPLINK##* }"
	if [ ! -f "$CPXY_STATE/$1" ] || ! cmp -s "$state" "$CPXY_STATE/$1" || ! ip link show "$TUN" >/dev/null 2>&1 ||
		{ [ "$GEOIP" = 1 ] && ! cpxy_geo_healthy "$PLAN/routes/$1" "$wan" $LAN_DEVS; }; then
		# Record before setup so partial failures remain removable.
		if [ "$GEOIP" = 1 ]; then
			[ -f "$CPXY_STATE/$1" ] || cp "$state" "$CPXY_STATE/$1"
			cpxy_geo_up "$PLAN/routes/$1" $UPLINK $LAN_DEVS || { cpxy_log "$1: GeoIP route generation failed; protection retained"; APPLY_OK=0; return 1; }
		else
			cp "$state" "$CPXY_STATE/$1"
			cpxy_net_up $LAN_DEVS || { cpxy_log "$1: could not set up policy routing"; APPLY_OK=0; return 1; }
		fi
		cp "$state" "$CPXY_STATE/$1"
	fi
	_start_worker "$1"
}

_apply_plan() {
	local state section
	mkdir -p "$CPXY_STATE"
	rm -f "$CPXY_RUN/geo-stopped"
	# A successful configuration can retire snapshots retained across an explicit stop.
	for state in "$CPXY_BOOT_STATE"/*; do
		[ -f "$state" ] || continue
		section="${state##*/}"
		if [ ! -f "$PLAN/$section" ] || [ "$(sed -n '8p' "$PLAN/$section")" != 1 ]; then
			rm -f "$state"
		fi
	done
	# Install protection before firewall changes or replacement of legacy route selectors.
	for state in "$PLAN"/*; do
		[ -f "$state" ] || continue
		_read_state "$state"
		if [ "$GEOIP" = 1 ]; then
			section="${state##*/}"
			# Boot needs resource assignments, not volatile gateway/policy identity. Avoid
			# writing flash for DHCP renewals and policy reloads that keep those resources.
			head -n 8 "$state" >"$PLAN/routes/$section.boot" || return 1
			if ! cmp -s "$PLAN/routes/$section.boot" "$CPXY_BOOT_STATE/$section"; then
				mkdir -p "$CPXY_BOOT_STATE" && chmod 700 "$CPXY_BOOT_STATE" &&
					cp "$PLAN/routes/$section.boot" "$CPXY_BOOT_STATE/.$section.new" &&
					mv -f "$CPXY_BOOT_STATE/.$section.new" "$CPXY_BOOT_STATE/$section" || {
					cpxy_log "$section: could not save early-boot protection"
					rm -rf "$PLAN"; return 1
				}
			fi
			[ -f "$CPXY_STATE/$section" ] || cp "$state" "$CPXY_STATE/$section"
			cpxy_geo_guard "$TUN" $LAN_DEVS || { rm -rf "$PLAN"; return 1; }
		fi
	done
	# procd replaces/removes workers when this service update is published.
	# Calling procd_kill here would overwrite the in-progress procd JSON message.
	# Reconcile old resource assignments, including deleted and disabled instances.
	for state in "$CPXY_STATE"/*; do
		[ -f "$state" ] || continue
		section="${state##*/}"
		if [ ! -f "$PLAN/$section" ] || ! cmp -s "$state" "$PLAN/$section"; then
			_read_state "$state"
			# A device change needs a new worker, but a bridge-only change does not.
			if [ "$GEOIP" = 1 ] && [ -f "$PLAN/$section" ]; then
				[ "$(sed -n '8p' "$PLAN/$section")" = 1 ] || {
					cpxy_log "$section: stop cpxy-router before disabling router_geoip"
					rm -rf "$PLAN"; return 1
				}
				# Keep the old complete generation and terminal guards through staging.
				continue
			elif [ "$GEOIP" = 1 ]; then
				cpxy_geo_down
				rm -f "$CPXY_BOOT_STATE/$section"
			elif [ ! -f "$PLAN/$section" ] || [ "$TUN" != "$(head -n 1 "$PLAN/$section")" ]; then
				cpxy_net_down_routing
			else
				_cpxy_net_down_rules
			fi
			rm -f "$state"
		fi
	done
	cpxy_firewall_sync "$PLAN" || { cpxy_log "firewall update failed"; rm -rf "$PLAN"; return 1; }
	ROUTED=0
	APPLY_OK=1
	cpxy_foreach _start_instance || APPLY_OK=0
	/usr/libexec/cpxy/boot-firewall.sh || { cpxy_log "could not reconcile boot forwarding barrier"; APPLY_OK=0; }
	rm -rf "$PLAN"
	if [ "$ROUTED" = 1 ] && [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = 1 ]; then
		cpxy_log "warning: hardware flow offloading may bypass the proxy"
	fi
	[ "$APPLY_OK" = 1 ]
}

start_service() {
	_prepare_plan || return 1
	_apply_plan
}

# Validate before opening a procd service update: invalid reloads preserve running workers.
reload_service() {
	_prepare_plan || return 1
	rc_procd _apply_plan
}

stop_service() {
	local state
	mkdir -p "$CPXY_RUN"
	: >"$CPXY_RUN/geo-stopped"
	for state in "$CPXY_STATE"/*; do
		[ -f "$state" ] || continue
		_read_state "$state"
		if [ "$GEOIP" = 1 ]; then cpxy_geo_down; else cpxy_net_down_routing; fi
	done
	cpxy_firewall_sync "" || cpxy_log "could not remove instance firewall configuration"
	/usr/libexec/cpxy/boot-firewall.sh clear || cpxy_log "could not remove boot forwarding barrier"
	rm -rf "$CPXY_STATE"
	# Keep non-secret assignments for the next enabled boot, including after a manual stop.
}

# rc.common's normal shutdown calls stop, which intentionally restores WAN access. Retain
# rules, persistent TUNs and boot snapshots during shutdown; the reboot clears kernel/tmp state.
shutdown() {
	procd_kill cpxy-router
}

_trigger_instance() {
	local iface
	[ "$CPXY_ROUTER" = 1 ] || return 0
	for iface in $CPXY_NETWORKS; do
		procd_add_interface_trigger "interface.*" "$iface" /etc/init.d/cpxy-router reload
	done
}

service_triggers() {
	procd_add_reload_trigger cpxy firewall
	# The direct prefixes contain the effective gateway/device; reconcile WAN renewals too.
	procd_add_raw_trigger "interface.*" 1000 /etc/init.d/cpxy-router reload
	config_load cpxy
	cpxy_foreach _trigger_instance
}
