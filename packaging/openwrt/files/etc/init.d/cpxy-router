#!/bin/sh /etc/rc.common
# Per routed cpxy instance: the kernel policy for its networks (the `inet cpxy` nftables table:
# direct IPv4 TCP forwarded, the rest redirected to the instance's cpxy-client), its firewall
# sections, and a `cpxy dns` worker answering its networks' DNS. The system's own resolver
# (dnsmasq) and the router's own traffic are left alone.
# rc.common consumes these service metadata variables.
# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10

. /lib/functions/network.sh
. /usr/libexec/cpxy/instance.sh
. /usr/libexec/cpxy/nft.sh
. /usr/libexec/cpxy/firewall.sh

CPXY_STATE="$CPXY_RUN/instances"
CPXY_BOOT_STATE=/etc/cpxy/router-guards

_invalid() { cpxy_log "$*"; VALID=0; }

_validate_network() {
	local iface="$1" zone dev network
	case "$iface" in '' | *[!A-Za-z0-9_]*) _invalid "$SECTION: invalid network name"; return ;; esac
	case " $NETWORKS " in *" $iface "*) _invalid "$SECTION: network '$iface' is assigned more than once" ;; esac
	NETWORKS="$NETWORKS $iface"
	zone="$(cpxy_firewall_zone "$iface")" || { _invalid "$SECTION: network '$iface' must belong to exactly one enabled firewall zone"; return; }
	case "$zone" in '' | *[!A-Za-z0-9_]*) _invalid "$SECTION: unsupported firewall zone name"; return ;; esac
	case " $ZONES " in *" $zone "*) ;; *) ZONES="$ZONES $zone" ;; esac
	# DNS is redirected per zone, so a zone must not also hold another instance's networks
	if [ "$CPXY_ROUTER_DNS" = 1 ]; then
		for network in $(cpxy_firewall_zone_networks "$zone"); do
			case " $CPXY_NETWORKS " in
			*" $network "*) ;;
			*) _invalid "$SECTION: firewall zone '$zone' also holds network '$network'; with router_dns, add it to this instance or move it to another zone" ;;
			esac
		done
	fi
	if network_get_device dev "$iface" && [ -n "$dev" ]; then
		_cpxy_nft_dev_ok "$dev" || { _invalid "$SECTION: unsupported device name '$dev'"; return; }
		case " $DEVICES " in *" $dev "*) _invalid "$SECTION: device '$dev' is assigned more than once" ;; esac
		DEVICES="$DEVICES $dev"
		LAN_DEVS="$LAN_DEVS $dev"
	else
		_invalid "$SECTION: interface '$iface' has no device yet; retaining boot protection until its network event"
	fi
}

_validate_instance() {
	local iface entry value dns_port=- hash
	SECTION="$1"
	[ "$CPXY_ROUTED" = 1 ] || return 0
	# The package installs without fw4 for client-only routers (fw3, OpenWrt 21.02 and older);
	# a routed network needs it.
	_cpxy_have_fw4 || {
		_invalid "$SECTION: routing networks needs fw4 (OpenWrt 22.03 or newer, with firewall4 and kmod-nft-nat); remove its networks or set router '0'"
		return
	}
	for entry in tun routing_table rule_priority; do
		config_get value "$SECTION" "$entry"
		[ -z "$value" ] || cpxy_log "$SECTION: option '$entry' is obsolete and ignored"
	done
	for entry in flow_offloading flow_offloading_hw; do
		[ "$(uci -q get "firewall.@defaults[0].$entry")" != 1 ] || {
			_invalid "$SECTION: disable $entry, which bypasses the redirect"
			return
		}
	done
	set -- routes cn-direct
	for entry in $CPXY_PROXY_ROUTES; do
		set -- "$@" --proxy-route "$entry"
	done
	{ "$CPXY_BIN/cpxy" "$@" && cpxy_nft_main_routes; } >"$PLAN/routes/$SECTION" ||
		{ _invalid "$SECTION: route export failed"; return; }
	hash="$(sha256sum <"$PLAN/routes/$SECTION" | cut -d ' ' -f 1)" || { _invalid "$SECTION: policy checksum failed"; return; }
	LAN_DEVS=""
	ZONES=""
	for iface in $CPXY_NETWORKS; do
		_validate_network "$iface"
	done
	[ "$CPXY_ROUTER_DNS" = 1 ] && dns_port="$(_cpxy_port "$CPXY_DNS_LISTEN")"
	# shellcheck disable=SC2086
	cpxy_nft_state "$PLAN/$SECTION" "$(_cpxy_port "$CPXY_TRANSPARENT_LISTEN")" "$dns_port" "$hash" "$(echo $ZONES)" $LAN_DEVS
}

_prepare_plan() {
	cpxy_validate || return 1
	PLAN="$(mktemp -d /tmp/cpxy-plan.XXXXXX)" || return 1
	mkdir "$PLAN/routes" || return 1
	VALID=1 NETWORKS="" DEVICES=""
	cpxy_foreach _validate_instance
	if [ "$VALID" != 1 ]; then
		rm -rf "$PLAN"
		return 1
	fi
}

_start_worker() {
	local entry
	procd_open_instance "${1}_dns"
	# The router's own sockets bypass the nftables policy, so the resolvers are routed by address
	procd_set_param command "$CPXY_BIN/cpxy" dns --resolver-routing cn_split --socks5-proxy "$CPXY_ROUTER_SOCKS5"
	# These overrides classify resolver destinations.
	for entry in $CPXY_PROXY_ROUTES; do procd_append_param command --proxy-route "$entry"; done
	procd_append_param command --listen "$CPXY_DNS_LISTEN"
	for entry in $CPXY_DNS_SEARCH_DOMAINS; do procd_append_param command --search-domain "$entry"; done
	for entry in $CPXY_DNS_UPSTREAM; do procd_append_param command --upstream "$entry"; done
	for entry in $CPXY_DNS_ALTERNATIVE; do procd_append_param command --alternative "$entry"; done
	procd_append_param command --local-server "$CPXY_DNS_LOCAL_SERVER"
	for entry in $CPXY_DNS_LOCAL_DOMAINS; do procd_append_param command --local-domain "$entry"; done
	[ "$CPXY_DNS_CACHE" = 1 ] || procd_append_param command --cache off
	cpxy_procd_env "router-$1" NO_COLOR=1
	# A package/data update must also replace DNS workers using the old embedded dataset.
	procd_append_param file "$CPXY_BIN/cpxy"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

_start_instance() {
	[ -f "$PLAN/$1" ] || return 0
	ROUTED=1
	cpxy_nft_read "$PLAN/$1"
	# Without router_dns there is nothing to run: the kernel carries the networks' TCP.
	[ "$DNS_PORT" = - ] || _start_worker "$1"
}

_masq_zone_devices() {
	local masq networks network dev
	config_get_bool masq "$1" masq 0
	[ "$masq" = 1 ] || return 0
	config_get networks "$1" network
	for network in $networks; do
		network_get_device dev "$network" && [ -n "$dev" ] && echo "$dev"
		network_get_physdev dev "$network" && [ -n "$dev" ] && echo "$dev"
	done
	config_get dev "$1" device
	[ -z "$dev" ] || echo $dev
}

# Where the internet is: the devices of the main table's default routes and of every
# masquerading firewall zone (down or not). Proxied TCP is redirected and guarded towards these,
# and towards any device that appears later; other devices' routes win over the proxy.
_uplinks() {
	ip -4 route show table main default | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1) }'
	(config_load firewall; config_foreach _masq_zone_devices zone)
}

# Removes what an instance of the TUN design left in the kernel, given its saved state.
_legacy_down() {
	local tun table priority
	{ read -r tun; read -r table; read -r priority; } <"$1"
	cpxy_legacy_down "$tun" "$table" "$priority"
}

_apply_plan() {
	local state section
	mkdir -p "$CPXY_STATE"
	rm -f "$CPXY_RUN/router-stopped"
	# Early-boot protection: which devices to hold until the table exists. Retire snapshots of
	# instances no longer routed; write flash only when a snapshot changes.
	for state in "$CPXY_BOOT_STATE"/*; do
		[ -f "$state" ] || continue
		[ -f "$PLAN/${state##*/}" ] || rm -f "$state"
	done
	for state in "$PLAN"/*; do
		[ -f "$state" ] || continue
		section="${state##*/}"
		cpxy_nft_read "$state"
		printf 'nft\n%s\n' "$LAN_DEVS" >"$PLAN/routes/$section.boot" || { rm -rf "$PLAN"; return 1; }
		if ! cmp -s "$PLAN/routes/$section.boot" "$CPXY_BOOT_STATE/$section"; then
			mkdir -p "$CPXY_BOOT_STATE" && chmod 700 "$CPXY_BOOT_STATE" &&
				cp "$PLAN/routes/$section.boot" "$CPXY_BOOT_STATE/.$section.new" &&
				mv -f "$CPXY_BOOT_STATE/.$section.new" "$CPXY_BOOT_STATE/$section" || {
				cpxy_log "$section: could not save early-boot protection"
				rm -rf "$PLAN"; return 1
			}
		fi
	done
	# One transaction replaces every instance's sets and rules: established connections keep
	# their NAT, and no packet sees a partial policy. Without nftables (fw3) nothing is routed:
	# validation refuses routed instances there.
	# shellcheck disable=SC2046
	if _cpxy_have_fw4; then
		cpxy_nft_render "$PLAN" $(cpxy_nft_exempt $(_uplinks)) >"$PLAN/routes/.ruleset" &&
			cpxy_nft_apply "$PLAN/routes/.ruleset" || {
			cpxy_log "could not install the nftables policy; the previous one stays"
			rm -rf "$PLAN"; return 1
		}
	fi
	# The guards are in place: lift the boot barrier from the devices they now cover.
	/usr/libexec/cpxy/boot-firewall.sh || cpxy_log "could not reconcile boot forwarding barrier"
	# Only now that the guards are in place, retire the TUN design's devices, tables and rules.
	for state in "$CPXY_STATE"/*; do
		[ -f "$state" ] || continue
		cpxy_nft_read "$state" || _legacy_down "$state"
		rm -f "$state"
	done
	cpxy_firewall_sync "$PLAN" || { cpxy_log "firewall update failed"; rm -rf "$PLAN"; return 1; }
	for state in "$PLAN"/*; do
		[ ! -f "$state" ] || cp "$state" "$CPXY_STATE/${state##*/}"
	done
	ROUTED=0
	APPLY_OK=1
	cpxy_foreach _start_instance || APPLY_OK=0
	/usr/libexec/cpxy/boot-firewall.sh || { cpxy_log "could not reconcile boot forwarding barrier"; APPLY_OK=0; }
	rm -rf "$PLAN"
	[ "$APPLY_OK" = 1 ]
}

start_service() {
	_prepare_plan || return 1
	_apply_plan
}

# Validate before opening a procd service update: invalid reloads preserve running workers.
reload_service() {
	_prepare_plan || return 1
	rc_procd _apply_plan
}

stop_service() {
	local state
	mkdir -p "$CPXY_RUN"
	: >"$CPXY_RUN/router-stopped"
	for state in "$CPXY_STATE"/*; do
		[ -f "$state" ] || continue
		cpxy_nft_read "$state" || _legacy_down "$state"
	done
	cpxy_nft_clear
	cpxy_firewall_sync "" || cpxy_log "could not remove instance firewall configuration"
	/usr/libexec/cpxy/boot-firewall.sh clear || cpxy_log "could not remove boot forwarding barrier"
	rm -rf "$CPXY_STATE"
	# Keep the boot snapshots for the next enabled boot, including after a manual stop.
}

# rc.common's normal shutdown calls stop, which intentionally restores WAN access. Keep the
# table and boot snapshots during shutdown; the reboot clears kernel and /tmp state.
shutdown() {
	procd_kill cpxy-router
}

_trigger_instance() {
	local iface
	[ "$CPXY_ROUTED" = 1 ] || return 0
	for iface in $CPXY_NETWORKS; do
		procd_add_interface_trigger "interface.*" "$iface" /etc/init.d/cpxy-router reload
	done
}

service_triggers() {
	procd_add_reload_trigger cpxy firewall
	# The direct set includes the main table's subnets; reconcile WAN and other interface changes.
	procd_add_raw_trigger "interface.*" 1000 /etc/init.d/cpxy-router reload
	config_load cpxy
	cpxy_foreach _trigger_instance
}
