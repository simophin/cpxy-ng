#!/bin/sh /etc/rc.common
# cpxy router service: client_cn (SOCKS5), tun2proxy (TUN -> SOCKS5) and dns_split (DNS).
# Config: /etc/config/cpxy. Runtime network state: /usr/libexec/cpxy/net.sh.

USE_PROCD=1
# After network (20), firewall (19) and dnsmasq (19)
START=95
STOP=10

. /lib/functions/network.sh
. /usr/libexec/cpxy/net.sh

BIN=/usr/bin

_log() {
	logger -t cpxy -p daemon.err "$*"
	echo "cpxy: $*" >&2
}

# Collect the devices of the configured LAN interfaces into $LAN_DEVS
_add_lan_interface() {
	local iface="$1" dev
	if network_get_device dev "$iface" && [ -n "$dev" ]; then
		LAN_DEVS="$LAN_DEVS $dev"
	else
		_log "interface '$iface' has no device yet; skipping it"
	fi
}

_count_entry() { _entries=$((_entries + 1)); }

# Fail with a clear message when a required list option in the main section is empty
_require_list() {
	_entries=0
	config_list_foreach main "$1" _count_entry
	[ "$_entries" -gt 0 ] || { _log "option '$1' is required: uci add_list cpxy.main.$1='<value>'"; return 1; }
}

_add_arg_list() {
	# _add_arg_list <flag> <value>: appends "--flag value" to the instance command
	procd_append_param command "$1" "$2"
}

start_service() {
	local enabled server socks5_listen api_listen dns_split dns_listen dns_cache
	config_load cpxy
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get server main server
	[ -n "$server" ] || { _log "option 'server' is not set in /etc/config/cpxy"; return 1; }
	config_get socks5_listen main socks5_listen 127.0.0.1:1080
	config_get api_listen main api_listen 127.0.0.1:3010
	config_get_bool dns_split main dns_split 1
	config_get dns_listen main dns_listen 127.0.0.1:5353
	config_get_bool dns_cache main dns_cache 1

	if [ "$dns_split" = 1 ]; then
		_require_list dns_upstream || return 1
		_require_list dns_alternative || return 1
	fi

	LAN_DEVS=""
	config_list_foreach main lan_interface _add_lan_interface
	[ -n "$LAN_DEVS" ] || { _log "no LAN device to proxy"; return 1; }

	if [ -n "$(uci -q get 'dhcp.@dnsmasq[0].server')" ]; then
		_log "warning: dhcp.@dnsmasq[0].server is set; dnsmasq may bypass dns_split for those servers"
	fi
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = 1 ]; then
		_log "warning: hardware flow offloading is on and may bypass the proxy; disable it in the firewall settings"
	fi

	# --- SOCKS5 proxy (client_cn) ---
	procd_open_instance proxy
	procd_set_param command $BIN/cpxy-client --socks5-proxy-listen "$socks5_listen" --api-listen "$api_listen"
	config_list_foreach main dns_server _add_dns_server
	# The server URL embeds the key: pass it by environment so it does not show up in `ps`
	procd_set_param env SERVER="$server" NO_COLOR=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# --- TUN -> SOCKS5 (tun2proxy); it attaches to the cpxy0 device that cpxy_net_up creates ---
	procd_open_instance tun
	procd_set_param command $BIN/cpxy-tun2proxy --proxy "socks5://$socks5_listen" --tun "$CPXY_TUN" \
		--dns direct --exit-on-fatal-error
	procd_set_param env NO_COLOR=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	cpxy_net_up $LAN_DEVS || { _log "could not set up policy routing"; cpxy_net_down_routing; return 1; }

	# --- DNS (dns_split behind dnsmasq) ---
	if [ "$dns_split" = 1 ]; then
		procd_open_instance dns
		procd_set_param command $BIN/cpxy-dns-split --listen "$dns_listen"
		config_list_foreach main dns_upstream _add_dns_upstream
		config_list_foreach main dns_alternative _add_dns_alternative
		if [ "$dns_cache" = 1 ]; then
			mkdir -p /tmp/cpxy
			procd_append_param command --cache-db /tmp/cpxy/dns-cache.sqlite
		else
			procd_append_param command --no-cache
		fi
		procd_set_param env NO_COLOR=1
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance

		cpxy_dnsmasq_up "$dns_listen"
	fi
}

_add_dns_server() { _add_arg_list --dns-server "$1"; }
_add_dns_upstream() { _add_arg_list --upstream "$1"; }
_add_dns_alternative() { _add_arg_list --alternative "$1"; }

stop_service() {
	cpxy_dnsmasq_down
	cpxy_net_down_routing
	rm -rf /tmp/cpxy
}

service_triggers() {
	procd_add_reload_trigger cpxy
	# A LAN device appearing after boot needs its rules
	procd_add_interface_trigger "interface.*.up" lan /etc/init.d/cpxy reload
}
