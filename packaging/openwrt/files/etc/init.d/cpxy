#!/bin/sh /etc/rc.common
# One native packet worker per named cpxy section; at most one shared DNS worker.
# rc.common consumes these service metadata variables.
# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10

. /lib/functions/network.sh
. /usr/libexec/cpxy/net.sh
. /usr/libexec/cpxy/firewall.sh

BIN=/usr/bin
CPXY_STATE=/tmp/cpxy/instances

_log() {
	logger -t cpxy -p daemon.err "$*"
	echo "cpxy: $*" >&2
}
_invalid() { _log "$*"; VALID=0; }
_count_entry() { _entries=$((_entries + 1)); }
_require_list() {
	_entries=0
	config_list_foreach "$1" "$2" _count_entry
	[ "$_entries" -gt 0 ] || { _invalid "$1: option '$2' is required"; return 1; }
}
_uint() {
	case "$1" in ''|*[!0-9]*|0[0-9]*) return 1 ;; esac
	[ "$1" -ge "$2" ] 2>/dev/null && [ "$1" -le "$3" ] 2>/dev/null
}

_validate_network() {
	local iface="$1" zone dev
	case "$iface" in ''|*[!A-Za-z0-9_]*) _invalid "$SECTION: invalid network name"; return ;; esac
	case " $NETWORKS " in *" $iface "*) _invalid "$SECTION: network '$iface' is assigned more than once" ;; esac
	NETWORKS="$NETWORKS $iface"
	zone="$(cpxy_firewall_zone "$iface")" || { _invalid "$SECTION: network '$iface' must belong to exactly one enabled firewall zone"; return; }
	case "$zone" in ''|*[!A-Za-z0-9_]*) _invalid "$SECTION: unsupported firewall zone name"; return ;; esac
	case " $ZONES " in *" $zone "*) ;; *) ZONES="$ZONES $zone" ;; esac
	if network_get_device dev "$iface" && [ -n "$dev" ]; then
		case " $DEVICES " in *" $dev "*) _invalid "$SECTION: device '$dev' is assigned more than once" ;; esac
		DEVICES="$DEVICES $dev"
		LAN_DEVS="$LAN_DEVS $dev"
	else
		_log "$SECTION: interface '$iface' has no device yet; awaiting network event"
	fi
}

_validate_instance() {
	local enabled server tun table priority dns_split
	SECTION="$1"
	config_get_bool enabled "$SECTION" enabled 0
	[ "$enabled" = 1 ] || return 0
	case "$SECTION" in ''|*[!A-Za-z0-9_]*) _invalid "use named cpxy sections with letters, digits or underscores"; return ;; esac
	config_get server "$SECTION" server
	[ -n "$server" ] || _invalid "$SECTION: option 'server' is not set"
	if [ "$SECTION" = main ]; then
		config_get tun "$SECTION" tun cpxy0
		config_get table "$SECTION" routing_table 100
		config_get priority "$SECTION" rule_priority 9100
	else
		config_get tun "$SECTION" tun
		config_get table "$SECTION" routing_table
		config_get priority "$SECTION" rule_priority
	fi
	case "$tun" in ''|*[!A-Za-z0-9_-]*|lo) _invalid "$SECTION: invalid or missing tun"; return ;; esac
	[ "${#tun}" -le 15 ] || { _invalid "$SECTION: tun exceeds 15 characters"; return; }
	if ip link show "$tun" >/dev/null 2>&1 && ! ip tuntap show dev "$tun" | grep -q "^$tun: tun"; then
		_invalid "$SECTION: existing device '$tun' is not a TUN"; return
	fi
	_uint "$table" 1 65535 && [ "$table" -ne 253 ] && [ "$table" -ne 254 ] && [ "$table" -ne 255 ] || {
		_invalid "$SECTION: routing_table must be 1..65535, excluding 253..255"; return;
	}
	_uint "$priority" 1 32762 || { _invalid "$SECTION: rule_priority must be 1..32762"; return; }
	case " $TUNS " in *" $tun "*) _invalid "$SECTION: duplicate tun '$tun'" ;; esac
	case " $TABLES " in *" $table "*) _invalid "$SECTION: duplicate routing_table '$table'" ;; esac
	local old
	for old in $PRIORITIES; do
		[ "$priority" -gt "$((old + 3))" ] || [ "$((priority + 3))" -lt "$old" ] || _invalid "$SECTION: overlapping rule priorities"
	done
	TUNS="$TUNS $tun"; TABLES="$TABLES $table"; PRIORITIES="$PRIORITIES $priority"
	LAN_DEVS=""; ZONES=""
	_require_list "$SECTION" lan_interface
	config_list_foreach "$SECTION" lan_interface _validate_network
	config_get_bool dns_split "$SECTION" dns_split "$([ "$SECTION" = main ] && echo 1 || echo 0)"
	if [ "$dns_split" = 1 ]; then
		[ -z "$DNS_OWNER" ] || _invalid "only one instance may enable the shared dns_split resolver"
		DNS_OWNER="$SECTION"
		_require_list "$SECTION" dns_upstream
		_require_list "$SECTION" dns_alternative
	fi
	printf '%s\n%s\n%s\n%s\n%s\n' "$tun" "$table" "$priority" "$LAN_DEVS" "$ZONES" >"$PLAN/$SECTION"
}

_prepare_plan() {
	PLAN="$(mktemp -d /tmp/cpxy-plan.XXXXXX)" || return 1
	VALID=1; NETWORKS=""; DEVICES=""; TUNS=""; TABLES=""; PRIORITIES=""; DNS_OWNER=""
	config_load cpxy
	config_foreach _validate_instance cpxy
	# Never assign a protected bridge as a TUN, even across different sections.
	local tun
	for tun in $TUNS; do
		case " $DEVICES " in *" $tun "*) _invalid "tun '$tun' is also a protected network device" ;; esac
	done
	if [ "$VALID" != 1 ]; then rm -rf "$PLAN"; return 1; fi
}

_read_state() {
	{ read -r TUN; read -r TABLE; read -r PRIORITY; read -r LAN_DEVS; read -r ZONES; } <"$1"
	cpxy_net_select "$TUN" "$TABLE" "$PRIORITY"
}

_start_worker() {
	local section="$1" server
	config_get server "$section" server
	procd_open_instance "${section}_tun"
	procd_set_param command "$BIN/cpxy-router" --tun "$TUN"
	procd_set_param env SERVER="$server" NO_COLOR=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
_add_dns_upstream() { procd_append_param command --upstream "$1"; }
_add_dns_alternative() { procd_append_param command --alternative "$1"; }
_start_dns() {
	local listen cache
	[ -n "$DNS_OWNER" ] || { cpxy_dnsmasq_down; return 0; }
	if [ -n "$(uci -q get 'dhcp.@dnsmasq[0].server')" ]; then
		_log "warning: dhcp.@dnsmasq[0].server is set; dnsmasq may bypass dns_split for those servers"
	fi
	config_get listen "$DNS_OWNER" dns_listen 127.0.0.1:5335
	config_get_bool cache "$DNS_OWNER" dns_cache 1
	procd_open_instance dns
	procd_set_param command /usr/libexec/cpxy/dns-split.sh "$listen" "$BIN/cpxy-dns-split" --listen "$listen"
	config_list_foreach "$DNS_OWNER" dns_upstream _add_dns_upstream
	config_list_foreach "$DNS_OWNER" dns_alternative _add_dns_alternative
	if [ "$cache" = 1 ]; then
		procd_append_param command --cache-db /tmp/cpxy/dns-cache.sqlite
	else
		procd_append_param command --no-cache
	fi
	procd_set_param env NO_COLOR=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

_apply_plan() {
	local state section
	mkdir -p "$CPXY_STATE"
	# procd replaces/removes workers when this service update is published.
	# Calling procd_kill here would overwrite the in-progress procd JSON message.
	# Reconcile old resource assignments, including deleted and disabled sections.
	for state in "$CPXY_STATE"/*; do
		[ -f "$state" ] || continue
		section="${state##*/}"
		if [ ! -f "$PLAN/$section" ] || ! cmp -s "$state" "$PLAN/$section"; then
			_read_state "$state"
			# A device change needs a new worker, but a bridge-only change does not.
			if [ ! -f "$PLAN/$section" ] || [ "$TUN" != "$(head -n 1 "$PLAN/$section")" ]; then
				cpxy_net_down_routing
			else
				_cpxy_net_down_rules
			fi
			rm -f "$state"
		fi
	done
	cpxy_firewall_sync "$PLAN" || { _log "firewall update failed"; rm -rf "$PLAN"; return 1; }
	for state in "$PLAN"/*; do
		[ -f "$state" ] || continue
		section="${state##*/}"
		_read_state "$state"
		if [ ! -f "$CPXY_STATE/$section" ] || ! cmp -s "$state" "$CPXY_STATE/$section" || ! ip link show "$TUN" >/dev/null 2>&1; then
			# Record before setup so partial failures remain removable.
			cp "$state" "$CPXY_STATE/$section"
			cpxy_net_up $LAN_DEVS || { _log "$section: could not set up policy routing"; rm -rf "$PLAN"; return 1; }
		fi
		_start_worker "$section"
	done
	_start_dns
	rm -rf "$PLAN"
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = 1 ]; then
		_log "warning: hardware flow offloading may bypass the proxy"
	fi
}

start_service() {
	_prepare_plan || return 1
	_apply_plan
}

# Validate before opening a procd service update: invalid reloads preserve running workers.
reload_service() {
	_prepare_plan || return 1
	rc_procd _apply_plan
}

stop_service() {
	local state
	cpxy_dnsmasq_down
	for state in "$CPXY_STATE"/*; do
		[ -f "$state" ] || continue
		_read_state "$state"
		cpxy_net_down_routing
	done
	cpxy_firewall_sync "" || _log "could not remove instance firewall configuration"
	rm -rf /tmp/cpxy
}

_trigger_interface() {
	procd_add_interface_trigger "interface.*" "$1" /etc/init.d/cpxy reload
}
_trigger_section() {
	local enabled
	config_get_bool enabled "$1" enabled 0
	[ "$enabled" = 1 ] || return 0
	config_list_foreach "$1" lan_interface _trigger_interface
}
service_triggers() {
	procd_add_reload_trigger cpxy firewall
	config_load cpxy
	config_foreach _trigger_section cpxy
}
