#!/bin/sh
[ "${IPKG_NO_SCRIPT:-}" != 1 ] || exit 0
[ -s "${IPKG_INSTROOT}/lib/functions.sh" ] || exit 0
. "${IPKG_INSTROOT}/lib/functions.sh"
export pkgname=cpxy
# Writes in the defaults of packages before local_region; only on the live root
[ -n "${IPKG_INSTROOT}" ] || sh /usr/libexec/cpxy/migrate-config.sh
default_postinst
