#!/bin/sh
set -e
# Upgrades keep the services running; postinst restarts them on the new version
case "$1" in remove | deconfigure) ;; *) exit 0 ;; esac
if [ -d /run/systemd/system ]; then
	# Stopping cleanly removes the routing and restores /etc/resolv.conf
	systemctl disable --now cpxy-router.service cpxy-dns-split.service || true
fi
exit 0
