# syntax=docker/dockerfile:1

# Run Cargo and rustc on the BuildKit host instead of emulating the target CPU. The image has
# rustup and zig, which compiles the C in Rust dependencies and links the static binary.
FROM --platform=$BUILDPLATFORM ghcr.io/rust-cross/cargo-zigbuild:0.23.3 AS builder

ARG TARGETARCH

WORKDIR /usr/src/app
COPY . .

RUN --mount=type=cache,id=cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry \
    --mount=type=cache,id=tsgw-target-${TARGETARCH},target=/usr/src/app/target \
    case "$TARGETARCH" in \
        amd64) rust_target=x86_64-unknown-linux-musl ;; \
        arm64) rust_target=aarch64-unknown-linux-musl ;; \
        *) echo "unsupported target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    mkdir -p /out/state && \
    cargo zigbuild --release --locked --target "$rust_target" -p cpxy-tsgw && \
    cp "target/$rust_target/release/cpxy-tsgw" /out/cpxy-tsgw

# The binary is static, and its TLS (Tailscale's control plane and DERP, the cpxy server, DNS over
# HTTPS) uses the root certificates built into it.
FROM scratch
COPY --from=builder /out/cpxy-tsgw /cpxy-tsgw

# Every runtime setting, with the image's defaults; override any with `-e`. Each is explained in
# docs/cpxy-tsgw.md. Only SERVER has no default: the container exits at once without it.
#
# The cpxy server URL with its key, e.g. https://:<key>@<host>:<port>
ENV SERVER=
# The node's name on the tailnet, and an auth key to log in without opening the link in the log
ENV TS_HOSTNAME=cpxy-tsgw
ENV TS_AUTHKEY=
# The UDP port WireGuard listens on; empty lets Tailscale pick one. Set it to publish the port
# (-p <port>:<port>/udp) or forward it on the router.
ENV TS_PORT=
# A different coordination server, e.g. Headscale; empty means Tailscale's
ENV CONTROL_URL=
# DNS servers whose answer is used when every address in it is in the local region, and servers
# whose answer is used otherwise (?via=cpxy asks one through the cpxy server). Empty means the
# program's defaults, listed in docs/cpxy-tsgw.md.
ENV DNS_UPSTREAM=
ENV DNS_ALTERNATIVE=
# The largest packet sent back to clients; Tailscale's MTU is 1280
ENV MTU=1280

# The node's Tailscale identity. Keep it across upgrades, or the machine is new each time.
ENV STATE_DIR=/var/lib/cpxy-tsgw
COPY --from=builder /out/state /var/lib/cpxy-tsgw
VOLUME /var/lib/cpxy-tsgw

ENTRYPOINT ["/cpxy-tsgw"]
