# syntax=docker/dockerfile:1

# One container per bundle: the cpxy client's HTTP proxy, and cpxy-tsgw (a Tailscale exit node)
# using it. s6-overlay starts and supervises the two; docs/docker-bundle.md explains the settings.

# Run Cargo and rustc on the BuildKit host instead of emulating the target CPU, as
# Dockerfile.tsgw does.
FROM --platform=$BUILDPLATFORM ghcr.io/rust-cross/cargo-zigbuild:0.23.3 AS builder

ARG TARGETARCH

WORKDIR /usr/src/app
COPY . .

RUN --mount=type=cache,id=cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry \
    --mount=type=cache,id=bundle-target-${TARGETARCH},target=/usr/src/app/target \
    case "$TARGETARCH" in \
        amd64) rust_target=x86_64-unknown-linux-musl ;; \
        arm64) rust_target=aarch64-unknown-linux-musl ;; \
        *) echo "unsupported target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    mkdir -p /out/state && \
    rustup target add "$rust_target" && \
    cargo zigbuild --release --locked --target "$rust_target" -p cpxy-tsgw -p client --bin cpxy-tsgw --bin standalone && \
    cp "target/$rust_target/release/cpxy-tsgw" /out/cpxy-tsgw && \
    cp "target/$rust_target/release/standalone" /out/cpxy-client

# s6-overlay's release archives, pinned by checksum, unpacked on the build host.
FROM --platform=$BUILDPLATFORM alpine:3.22 AS s6
ARG TARGETARCH
ARG S6_OVERLAY_VERSION=3.2.3.2
ADD --checksum=sha256:5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12 \
    https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp/noarch.tar.xz
ADD --checksum=sha256:e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408 \
    https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz /tmp/amd64.tar.xz
ADD --checksum=sha256:b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c \
    https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-aarch64.tar.xz /tmp/arm64.tar.xz
RUN apk add --no-cache xz >/dev/null && \
    mkdir /out && \
    tar -C /out -Jxpf /tmp/noarch.tar.xz && \
    tar -C /out -Jxpf "/tmp/$TARGETARCH.tar.xz"

# Alpine, for the shell the setup script and s6-overlay need, and its CA roots for Tailscale's
# control plane and DERP servers.
FROM alpine:3.22
COPY --from=s6 /out/ /
COPY --from=builder /out/cpxy-client /out/cpxy-tsgw /usr/bin/
COPY packaging/docker/rootfs/ /

# Every setting, with the image's defaults; override any with `-e`. Each is explained in
# docs/docker-bundle.md. Only SERVER has no default: the container stops at once without it.
#
# The cpxy server URL with its key, e.g. https://:<key>@<host>:<port>; the client and tsgw share it
ENV SERVER=
# The client's proxies. tsgw reaches the HTTP proxy on loopback at its port. SOCKS5 is off unless
# set, e.g. [::]:1080.
ENV HTTP_PROXY_LISTEN=[::]:5000
ENV SOCKS5_PROXY_LISTEN=
# DNS servers whose answer is used when every address in it is in the local region, and servers
# whose answer is used otherwise, here asked through the cpxy server (?via=cpxy)
ENV DNS_UPSTREAM=223.5.5.5
ENV DNS_ALTERNATIVE=tcp://1.1.1.1?via=cpxy
# The node's name on the tailnet, and an auth key to log in without opening the link in the log
ENV TS_HOSTNAME=cpxy-tsgw
ENV TS_AUTHKEY=
# The UDP port WireGuard listens on; empty lets Tailscale pick one. Only worth setting to forward
# it, for direct connections behind a NAT that hole punching cannot get through.
ENV TS_PORT=
# A different coordination server, e.g. Headscale; empty means Tailscale's
ENV CONTROL_URL=
# The largest packet sent back to clients; Tailscale's MTU is 1280
ENV MTU=1280

ENV NO_COLOR=1
# Stop the container when the setup script refuses the settings, rather than run without them
ENV S6_BEHAVIOUR_IF_STAGE2_FAILS=2
# The node's Tailscale identity. Keep it across upgrades, or the machine is new each time.
ENV STATE_DIR=/var/lib/cpxy-tsgw
VOLUME /var/lib/cpxy-tsgw

EXPOSE 5000/tcp
HEALTHCHECK --interval=30s --start-period=20s CMD ["/etc/cpxy/healthcheck"]
ENTRYPOINT ["/init"]
