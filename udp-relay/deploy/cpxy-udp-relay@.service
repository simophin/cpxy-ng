[Unit]
Description=Managed generic UDP relay %i
Requires=cpxy-port-agent.service
After=network-online.target cpxy-port-agent.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cpxy-udp-relay managed /etc/cpxy-relay/%i.json
ExecStopPost=/usr/local/bin/cpxy-udp-relay cleanup /etc/cpxy-relay/%i.json
Restart=on-failure
RestartSec=2
# The configured identity must match the local agent policy allowed_uid.
# Keep the agent/firewalld running until ExecStopPost has completed.
UMask=0077

[Install]
WantedBy=multi-user.target
